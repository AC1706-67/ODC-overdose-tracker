# Auto-detect text files and normalize line endings to LF on checkout
* text=auto eol=lf

# Explicitly declare text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sql text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.pro text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.gitignore text eol=lf
*.easignore text eol=lf
*.npmrc text eol=lf
*.prettierrc text eol=lf
*.prettierignore text eol=lf
*.env text eol=lf
*.env.* text eol=lf

# Shell scripts must be LF and executable
*.sh text eol=lf

# Declare binary files (don't touch line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.apk binary
*.aab binary
*.jar binary
*.keystore binary
*.jks binary
*.p12 binary
*.p8 binary
*.pem binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Expo/React Native lock files
package-lock.json text eol=lf -diff
yarn.lock text eol=lf -diff
